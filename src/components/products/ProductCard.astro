---
import type { Product } from '../../types/global';

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<li>
    <a
        href=`/store/${product.id}/${product.slug}`
        class="flex h-full flex-col gap-4 justify-between group"
    >
        <div
            class="hover:shadow-sm ease-in-out duration-200 h-full flex items-center justify-center"
        >
            <div class="overflow-hidden rounded-xl">
                <img
                    src={product.src}
                    alt={product.alt}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    width="640"
                    height="640"
                />
            </div>
        </div>
        <div class="flex text-sm justify-between">
            <p>{product.name}</p>
            <p data-testid="price">€{product.price}</p>
        </div>
    </a>
</li>