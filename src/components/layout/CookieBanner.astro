---

---

<div
  id="cookie-banner"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
  class="fixed bottom-4 left-4 right-4 z-50 mx-auto max-w-md translate-y-8 opacity-0 pointer-events-none transition-all duration-300 ease-out sm:left-6 sm:right-auto sm:mx-0"
>
  <div
    class="rounded-2xl border border-zinc-200/80 bg-white/95 p-5 shadow-2xl shadow-zinc-950/10 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-900/95"
  >
    <div class="flex items-start gap-3.5">
      <div
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-zinc-100 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"></path>
          <path d="M8.5 8.5v.01"></path>
          <path d="M16 15.5v.01"></path>
          <path d="M12 12v.01"></path>
          <path d="M11 17v.01"></path>
          <path d="M7 14v.01"></path>
        </svg>
      </div>

      <div class="flex-1">
        <h3
          id="cookie-title"
          class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100"
        >
          Your Shopping Privacy
        </h3>
        <p
          id="cookie-desc"
          class="mt-1 text-xs leading-relaxed text-zinc-600 dark:text-zinc-400"
        >
          We use cookies to analyze traffic and improve your experience.
        </p>
      </div>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-2.5">
      <button
        id="decline-cookies"
        type="button"
        class="inline-flex items-center justify-center cursor-pointer rounded-xl border border-zinc-200 bg-white px-4 py-2.5 text-xs font-medium text-zinc-700 transition-colors hover:bg-zinc-50 focus:outline-none focus:ring-2 focus:ring-zinc-900/10 active:scale-[0.99] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700/70"
      >
        Essential Only
      </button>
      <button
        id="accept-cookies"
        type="button"
        class="inline-flex items-center justify-center cursor-pointer rounded-xl bg-zinc-900 px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-900 focus:ring-offset-2 active:scale-[0.99] dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
      >
        Accept All
      </button>
    </div>
  </div>
</div>

<script>
  import Clarity from "@microsoft/clarity";

  const PROJECT_ID = "z3g4g5gpkq";
  const COOKIE_CONSENT_KEY = "cookie_consent_state";

  Clarity.init(PROJECT_ID);

  function setupCookieBanner() {
    const cookieBannerEl =
      document.querySelector<HTMLDivElement>("#cookie-banner");
    const acceptCookiesBtnEl =
      document.querySelector<HTMLButtonElement>("#accept-cookies");
    const declineCookiesBtnEl =
      document.querySelector<HTMLButtonElement>("#decline-cookies");

    const savedConsent = localStorage.getItem(COOKIE_CONSENT_KEY);

    if (savedConsent === "granted") {
      setClarityConsent(true);
    } else if (savedConsent === "denied") {
      setClarityConsent(false);
    } else if (cookieBannerEl) {
      setTimeout(showBanner, 400);
    }

    acceptCookiesBtnEl?.addEventListener("click", () => {
      localStorage.setItem(COOKIE_CONSENT_KEY, "granted");
      setClarityConsent(true);

      hideBanner();
    });

    declineCookiesBtnEl?.addEventListener("click", () => {
      localStorage.setItem(COOKIE_CONSENT_KEY, "denied");
      setClarityConsent(false);

      hideBanner();
    });

    function showBanner() {
      if (!cookieBannerEl) {
        return;
      }

      cookieBannerEl.classList.remove(
        "translate-y-8",
        "opacity-0",
        "pointer-events-none",
      );
      cookieBannerEl.classList.add(
        "translate-y-0",
        "opacity-100",
        "pointer-events-auto",
      );
    }

    function hideBanner() {
      if (!cookieBannerEl) {
        return;
      }

      cookieBannerEl.classList.remove(
        "translate-y-0",
        "opacity-100",
        "pointer-events-auto",
      );
      cookieBannerEl.classList.add(
        "translate-y-8",
        "opacity-0",
        "pointer-events-none",
      );
    }

    function setClarityConsent(isGranted: boolean) {
      if (isGranted) {
        Clarity.consentV2({
          ad_Storage: "granted",
          analytics_Storage: "granted",
        });
      } else {
        Clarity.consentV2({
          ad_Storage: "denied",
          analytics_Storage: "denied",
        });
      }
    }
  }

  setupCookieBanner();
  document.addEventListener("astro:after-swap", setupCookieBanner);
</script>
