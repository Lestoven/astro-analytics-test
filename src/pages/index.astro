---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<section class="w-full mx-0 py-12 lg:py-0">
		<div
			class="flex flex-row justify-between w-full gap-8 lg:gap-12 items-center"
		>
			<div class="flex flex-col gap-6 w-full md:flex-1 md:max-w-2xl">
				<h1 class="text-5xl font-bold leading-tight tracking-tight">
					Astro <span class="whitespace-nowrap">e-commerce</span> analytics demo
				</h1>
				<p class="text-gray-500 text-base leading-relaxed">
					Lorem ipsum dolor, sit amet consectetur adipisicing elit. Fugit consequuntur veniam consequatur, ut tempora ab voluptatem libero quidem quasi adipisci.
				</p>
				<div class="flex items-center gap-4 mt-2">
					<a
						href="https://github.com/Lestoven/astro-analytics-test"
						target="_blank"
						class="px-6 py-3 bg-black text-white text-sm font-medium rounded-full hover:bg-gray-800 transition-colors"
					>
						Open Github
					</a>
					<a
						href="/store"
						class="px-6 py-3 border border-black text-black text-sm font-medium rounded-full hover:bg-gray-100 transition-colors"
					>
						Browse products
					</a>
				</div>
			</div>

			<div class="hidden md:flex justify-end items-center">
				<img
					src="/products/black-t-shirt.png"
					alt="Black T-Shirt"
					class="w-full max-w-[750px] lg:scale-110 object-contain object-right select-none"
				/>
			</div>
		</div>
	</section>
</Layout>
